# Contentful — optional. If unset, the app uses local fixtures (see
# src/lib/fixtures/fixturePages.ts) so /preview/home and /preview/launch
# work out of the box.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# When set to "true", the public preview will render a yellow notice for
# unsupported sections rather than hiding them. Useful in staging.
NEXT_PUBLIC_SHOW_UNSUPPORTED_NOTICE=false
